    ],
    "description": "An nth root"
  },
  "Sum": {
    "prefix": "sum",
    "body": [
      "\\sum_{${1:i=1}}^{${2:n}} $0"
    ],
    "description": "A sum with limits"
  },
  "Product": {
    "prefix": "prod",
    "body": [
      "\\prod_{${1:i=1}}^{${2:n}} $0"
    ],
