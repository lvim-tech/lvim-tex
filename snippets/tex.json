      "\\end{abstract}"
    ],
    "description": "The abstract"
  },
  "Equation": {
    "prefix": "equation",
    "body": [
      "\\begin{equation}",
      "\t\\label{eq:${1:key}}",
      "\t$0",
      "\\end{equation}"
    ],
    "description": "A numbered equation with a label"
  },
  "Equation (unnumbered)": {
    "prefix": "equation*",
    "body": [
      "\\begin{equation*}",
      "\t$0",
      "\\end{equation*}"
    ],
    "description": "An unnumbered equation"
  },
  "Align": {
    "prefix": "align",
    "body": [
      "\\begin{align}",
      "\t${1:a} &= ${2:b} \\\\\\\\",
      "\t$0",
      "\\end{align}"
    ],
    "description": "Aligned equations"
  },
  "Align (unnumbered)": {
    "prefix": "align*",
    "body": [
      "\\begin{align*}",
      "\t${1:a} &= ${2:b} \\\\\\\\",
      "\t$0",
      "\\end{align*}"
    ],
    "description": "Unnumbered aligned equations"
  },
  "Gather": {
    "prefix": "gather",
    "body": [
      "\\begin{gather}",
      "\t$0",
      "\\end{gather}"
    ],
    "description": "Gathered equations"
  },
  "Cases": {
    "prefix": "cases",
    "body": [
      "\\begin{cases}",
      "\t${1:a} & \\text{if } ${2:condition} \\\\\\\\",
      "\t${3:b} & \\text{otherwise}",
      "\\end{cases}",
      "$0"
    ],
    "description": "A cases block"
  },
  "Matrix (parentheses)": {
    "prefix": "pmatrix",
    "body": [
      "\\begin{pmatrix}",
      "\t${1:a} & ${2:b} \\\\\\\\",
      "\t${3:c} & ${4:d}",
      "\\end{pmatrix}",
      "$0"
    ],
    "description": "A 2x2 matrix in parentheses"
  },
  "Matrix (brackets)": {
    "prefix": "bmatrix",
    "body": [
      "\\begin{bmatrix}",
      "\t${1:a} & ${2:b} \\\\\\\\",
      "\t${3:c} & ${4:d}",
      "\\end{bmatrix}",
      "$0"
    ],
    "description": "A 2x2 matrix in brackets"
  },
  "Theorem": {
    "prefix": "theorem",
    "body": [
      "\\begin{theorem}[${1:name}]",
      "\t\\label{thm:${2:key}}",
      "\t$0",
      "\\end{theorem}"
    ],
    "description": "A theorem with a label"
  },
  "Lemma": {
    "prefix": "lemma",
    "body": [
      "\\begin{lemma}",
      "\t$0",
      "\\end{lemma}"
    ],
    "description": "A lemma"
  },
  "Definition": {
    "prefix": "definition",
    "body": [
      "\\begin{definition}",
      "\t$0",
      "\\end{definition}"
    ],
