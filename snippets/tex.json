      "\\begin{proof}",
      "\t$0",
      "\\end{proof}"
    ],
    "description": "A proof"
  },
  "Inline maths": {
    "prefix": "mk",
    "body": [
      "\\$${1}\\$$0"
    ],
    "description": "Inline maths ($…$)"
  },
  "Display maths": {
    "prefix": "dm",
    "body": [
      "\\[",
      "\t$0",
      "\\]"
    ],
    "description": "Display maths (\\[…\\])"
  },
  "Fraction": {
    "prefix": "frac",
    "body": [
      "\\frac{${1:a}}{${2:b}}$0"
    ],
    "description": "A fraction"
  },
  "Display fraction": {
    "prefix": "dfrac",
    "body": [
      "\\dfrac{${1:a}}{${2:b}}$0"
    ],
    "description": "A display-style fraction"
  },
  "Square root": {
    "prefix": "sqrt",
    "body": [
      "\\sqrt{${1:x}}$0"
    ],
