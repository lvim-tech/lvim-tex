{
  "Article skeleton": {
    "prefix": "article",
    "body": [
      "\\documentclass[${1:11pt}]{article}",
      "\\usepackage[utf8]{inputenc}",
      "\\usepackage{amsmath, amssymb}",
      "",
      "\\title{${2:Title}}",
      "\\author{${3:Author}}",
      "\\date{${4:\\today}}",
      "",
      "\\begin{document}",
      "\\maketitle",
      "",
      "$0",
      "",
      "\\end{document}"
    ],
    "description": "A complete article: class, the usual packages, a title block and the document body"
  },
  "Beamer skeleton": {
    "prefix": "beamer",
    "body": [
      "\\documentclass{beamer}",
      "\\usetheme{${1:default}}",
      "",
      "\\title{${2:Title}}",
      "\\author{${3:Author}}",
      "",
      "\\begin{document}",
      "\\frame{\\titlepage}",
      "",
      "\\begin{frame}{${4:First slide}}",
      "\t$0",
      "\\end{frame}",
      "",
      "\\end{document}"
    ],
    "description": "A beamer presentation with a title slide and one frame"
  },
  "Document class": {
    "prefix": "documentclass",
    "body": [
      "\\documentclass[${1:11pt}]{${2:article}}$0"
    ],
    "description": "The document class"
  },
  "Use package": {
    "prefix": "usepackage",
    "body": [
      "\\usepackage[${1:options}]{${2:package}}$0"
    ],
    "description": "Load a package"
  },
  "Document environment": {
    "prefix": "document",
    "body": [
      "\\begin{document}",
      "$0",
      "\\end{document}"
    ],
    "description": "The document environment"
  },
  "Part": {
    "prefix": "part",
    "body": [
      "\\part{${1:Part}}\\label{prt:${2:key}}",
      "$0"
    ],
    "description": "A \\part heading with its label"
  },
  "Chapter": {
    "prefix": "chapter",
    "body": [
      "\\chapter{${1:Chapter}}\\label{cha:${2:key}}",
      "$0"
    ],
    "description": "A \\chapter heading with its label"
  },
  "Section": {
    "prefix": "section",
    "body": [
      "\\section{${1:Section}}\\label{sec:${2:key}}",
      "$0"
    ],
    "description": "A \\section heading with its label"
  },
  "Subsection": {
    "prefix": "subsection",
    "body": [
      "\\subsection{${1:Subsection}}\\label{sub:${2:key}}",
      "$0"
    ],
    "description": "A \\subsection heading with its label"
  },
  "Subsubsection": {
    "prefix": "subsubsection",
    "body": [
      "\\subsubsection{${1:Subsubsection}}\\label{ssub:${2:key}}",
      "$0"
    ],
    "description": "A \\subsubsection heading with its label"
  },
  "Paragraph": {
    "prefix": "paragraph",
    "body": [
      "\\paragraph{${1:Paragraph}}\\label{par:${2:key}}",
      "$0"
    ],
    "description": "A \\paragraph heading with its label"
  },
  "Environment": {
    "prefix": "begin",
    "body": [
      "\\begin{${1:environment}}",
      "\t$0",
      "\\end{$1}"
    ],
    "description": "Any environment — the name mirrors into the \\end"
  },
  "Itemize": {
    "prefix": "itemize",
    "body": [
      "\\begin{itemize}",
      "\t\\item $0",
      "\\end{itemize}"
    ],
    "description": "A bulleted list"
  },
  "Enumerate": {
    "prefix": "enumerate",
    "body": [
      "\\begin{enumerate}",
      "\t\\item $0",
      "\\end{enumerate}"
    ],
    "description": "A numbered list"
  },
  "Description": {
    "prefix": "description",
    "body": [
      "\\begin{description}",
      "\t\\item[${1:term}] $0",
      "\\end{description}"
    ],
    "description": "A description list"
  },
  "Item": {
    "prefix": "item",
    "body": [
      "\\item $0"
    ],
    "description": "One list item"
  },
  "Figure": {
    "prefix": "figure",
    "body": [
      "\\begin{figure}[${1:htbp}]",
      "\t\\centering",
      "\t\\includegraphics[width=${2:0.8}\\textwidth]{${3:file}}",
      "\t\\caption{${4:caption}}",
      "\t\\label{fig:${5:key}}",
      "\\end{figure}",
      "$0"
    ],
    "description": "A figure with a graphic, a caption and a label"
  },
  "Table": {
    "prefix": "table",
    "body": [
      "\\begin{table}[${1:htbp}]",
      "\t\\centering",
      "\t\\begin{tabular}{${2:ll}}",
      "\t\t${3:a} & ${4:b} \\\\\\\\",
      "\t\\end{tabular}",
      "\t\\caption{${5:caption}}",
      "\t\\label{tab:${6:key}}",
      "\\end{table}",
      "$0"
    ],
    "description": "A table with a tabular body, a caption and a label"
  },
  "Tabular": {
    "prefix": "tabular",
    "body": [
      "\\begin{tabular}{${1:ll}}",
      "\t${2:a} & ${3:b} \\\\\\\\",
      "\\end{tabular}",
      "$0"
    ],
    "description": "A tabular block"
  },
  "Center": {
    "prefix": "center",
    "body": [
      "\\begin{center}",
      "\t$0",
      "\\end{center}"
    ],
    "description": "A centred block"
  },
  "Quote": {
    "prefix": "quote",
    "body": [
      "\\begin{quote}",
      "\t$0",
      "\\end{quote}"
    ],
    "description": "A quotation"
  },
  "Verbatim": {
    "prefix": "verbatim",
    "body": [
      "\\begin{verbatim}",
      "$0",
      "\\end{verbatim}"
    ],
    "description": "Verbatim text"
  },
  "Code listing": {
    "prefix": "lstlisting",
    "body": [
      "\\begin{lstlisting}[language=${1:C}]",
      "$0",
      "\\end{lstlisting}"
    ],
    "description": "A listings code block"
  },
  "Minted block": {
    "prefix": "minted",
    "body": [
      "\\begin{minted}{${1:python}}",
      "$0",
      "\\end{minted}"
    ],
    "description": "A minted code block"
  },
  "Frame": {
    "prefix": "frame",
    "body": [
      "\\begin{frame}{${1:title}}",
      "\t$0",
      "\\end{frame}"
    ],
    "description": "A beamer frame"
  },
  "Abstract": {
    "prefix": "abstract",
    "body": [
      "\\begin{abstract}",
