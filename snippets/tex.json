  },
  "Binomial": {
    "prefix": "binom",
    "body": [
      "\\binom{${1:n}}{${2:k}}$0"
    ],
    "description": "A binomial coefficient"
  },
  "Scaled delimiters": {
    "prefix": "lr",
    "body": [
      "\\left${1:(} $2 \\right${3:)}$0"
    ],
    "description": "A \\left…\\right pair"
  },
  "Text in maths": {
    "prefix": "tx",
    "body": [
      "\\text{${1:text}}$0"
    ],
    "description": "Prose inside a formula"
  },
  "Overline": {
    "prefix": "overline",
    "body": [
      "\\overline{${1:x}}$0"
    ],
    "description": "An overline"
  },
  "Vector": {
    "prefix": "vec",
    "body": [
      "\\vec{${1:v}}$0"
    ],
    "description": "A vector"
  },
  "Label": {
